(load-theme 'tango-dark)

(set-frame-font "JetBrainsMonoNLNF 10" nil t)

(global-display-line-numbers-mode 1)
(setq display-line-numbers-type 'relative)

(setq inhibit-startup-screen t)

(tool-bar-mode 0)
(menu-bar-mode 0)
(scroll-bar-mode 0)
(column-number-mode 1)
(show-paren-mode 1)

(ido-mode 1)
(ido-everywhere 1)
